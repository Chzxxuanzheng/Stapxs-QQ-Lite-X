    "main": "./out/main/index.js",
    "type": "module",
    "scripts": {
        "capacitor:copy:before": "capacitor-sync-version",
        "lint": "eslint . --fix --cache; vue-tsc --noEmit -p tsconfig.web.json",
        "update:icon": "npx @capacitor/assets generate --assetPath 'src/mobile/_assets' --iosProject 'src/mobile/ios/App' --androidProject 'src/mobile/android' --android --ios",
        "update:version": "npx @stapxs/capacitor-sync-version android ios",
        "dev": "vite dev",
        "preview": "vite preview",
        "dev:electron": "electron-vite dev",
        "proxy": "node proxy.js",
        "dev:ios": "vite build && capacitor sync ios && capacitor run ios",
        "dev:android": "vite build && capacitor sync android && capacitor run android",
        "open:ios": "vite build && capacitor sync ios && capacitor open ios",
        "open:android": "vite build && capacitor sync android && capacitor open android",
        "build": "vite build",
        "build:electron": "electron-vite build && electron-builder",
        "verify:electron:win": "node ./scripts/verify-electron-win.mjs",
        "verify:electron:win:quick": "node ./scripts/verify-electron-win.mjs --skip-build --retries=1 --run-seconds=30 --no-probe-rebuild",
        "build:ios": "vite build && capacitor sync ios && sh ./scripts/build-export-ipa.sh",
        "build:android": "vite build && capacitor sync android && capacitor build android"
    },
